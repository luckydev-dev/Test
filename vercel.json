{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "cp -R public/. ./",
  "functions": {
    "api/index.js": {
      "includeFiles": "public/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/resolve", "destination": "/api/index" },
    { "source": "/api/media", "destination": "/api/index" },
    { "source": "/api/download", "destination": "/api/index" },
    { "source": "/api/health", "destination": "/api/index" },
    { "source": "/((?!api/index).*)", "destination": "/api/index" }
  ]
}
